{
  "name": "@red-cup-engineering/http-edge-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "HTTP edge middleware: TLS/ACME, virtual hosting, reverse proxy, rate limiting, CORS, CSRF, sessions, auth, WebSocket upgrade, ESI, and surrogate caching. Sits in front of an @red-cup-engineering/http-server-core-service app.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/http-edge-service.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "package.json"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/computing-with-http": "^0.1.0",
    "@red-cup-engineering/cryptographic-computer-data-engineering-services-section": "0.3.8-dev.0",
    "@red-cup-engineering/http-server-core-service": "workspace:*",
    "@red-cup-engineering/metrologic": "^0.22.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
